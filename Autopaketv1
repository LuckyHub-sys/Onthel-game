local function setStatus(message)
    status.Text = "Status: " .. message
end

local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function teleport(part)
    if not part or not part:IsA("BasePart") then
        return false
    end

    local character = player.Character
    if not character then return false end

    character:PivotTo(part.CFrame * CFrame.new(0, 0, -3))
    task.wait(0.5)

    return true
end

local function holdPrompt(prompt)
    if not running or not prompt or not prompt.Enabled then
        return false
    end

    if not prompt:IsA("ProximityPrompt") then
        return false
    end

    prompt:InputHoldBegin()
    task.wait(3)
    prompt:InputHoldEnd()

    task.wait(0.7)
    return running
end

local function findActiveDelivery()
    for _, house in ipairs(deliveryPoints:GetChildren()) do
        local door = house:FindFirstChild("Door")

        if door then
            local prompt = door:FindFirstChild("DeliverPrompt")

            if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                return house, door, prompt
            end
        end
    end

    return nil
end

local function runAuto()
    while running do
        setStatus("Menuju kantor...")

        teleport(mainPart)

        if not running then break end

        local pickup = mainPart:FindFirstChild("Ambil Paket")

        if not pickup or not pickup:IsA("ProximityPrompt") then
            setStatus("Prompt kantor tidak ditemukan")
            break
        end

        setStatus("Mengambil paket...")
        holdPrompt(pickup)

        if not running then break end

        setStatus("Mencari tujuan...")

        local house, door, prompt

        for i = 1, 100 do
            if not running then break end

            house, door, prompt = findActiveDelivery()

            if house then break end

            task.wait(0.2)
        end

        if not running then break end

        if not house then
            setStatus("Tujuan tidak ditemukan")
            break
        end

        setStatus("Menuju " .. house.Name .. "...")

        teleport(door)

        if not running then break end

        setStatus("Mengantar: " .. house.Name)

        holdPrompt(prompt)

        if not running then break end

        setStatus("Paket selesai!")

        task.wait(1)
    end

    running = false
    toggle.Text = "AUTO PAKET : OFF"
    toggle.BackgroundColor3 = Color3.fromRGB(45, 48, 60)

    if status.Text ~= "Status: Tujuan tidak ditemukan"
    and status.Text ~= "Status: Prompt kantor tidak ditemukan" then
        setStatus("OFF")
    end
end

toggle.MouseButton1Click:Connect(function()
    if running then
        running = false
        setStatus("Menghentikan...")
    else
        running = true
        toggle.Text = "AUTO PAKET : ON"
        toggle.BackgroundColor3 = Color3.fromRGB(35, 120, 75)

        task.spawn(runAuto)
    end
end)
